{
  "name": "sync-http-method",
  "version": "0.3.0",
  "description": "Keep many HTTP resources in sync with QUERY: per-resource patches for any media type, consistent snapshots, live watches, atomic multi-resource writes, and catch-up that shared caches can serve.",
  "main": "client/src/index.js",
  "types": "client/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./client/src/index.d.ts",
      "default": "./client/src/index.js"
    },
    "./server": {
      "types": "./server/src/package.d.ts",
      "default": "./server/src/package.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "client/src",
    "server/src",
    "shared",
    "spec",
    "README.md"
  ],
  "scripts": {
    "test": "jest server/tests --forceExit",
    "start": "node server/src/index.js",
    "demo": "node demo/demo.js",
    "bench": "node benchmarks/comparative.js",
    "bench:consistency": "node benchmarks/consistency.js",
    "bench:storm": "node benchmarks/storm.js",
    "bench:live": "node benchmarks/live.js",
    "bench:writes": "node benchmarks/writes.js"
  },
  "keywords": [
    "atomic",
    "braid",
    "catch-up",
    "cdn",
    "consistency",
    "delta",
    "http",
    "http-method",
    "json-patch",
    "live-updates",
    "merge-patch",
    "multipart",
    "offline",
    "query",
    "rest",
    "server-sent-events",
    "sse",
    "sync",
    "synchronization",
    "transactions"
  ],
  "author": "Meet Chauhan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meet-1010/sync-http-method.git"
  },
  "homepage": "https://github.com/Meet-1010/sync-http-method#readme",
  "bugs": {
    "url": "https://github.com/Meet-1010/sync-http-method/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "dependencies": {
    "diff": "^8.0.4",
    "fast-json-patch": "^3.1.1"
  },
  "devDependencies": {
    "braid-http": "^1.5.1",
    "express": "^5.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "undici": "^8.11.2"
  }
}
