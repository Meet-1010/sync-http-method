{
  "name": "sync-http-method",
  "version": "0.2.0",
  "description": "Catch up many HTTP resources in one request: per-resource patches or snapshots, with a POST fallback that works on any server.",
  "main": "client/src/index.js",
  "types": "client/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./client/src/index.d.ts",
      "default": "./client/src/index.js"
    },
    "./server": {
      "types": "./server/src/package.d.ts",
      "default": "./server/src/package.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "client/src",
    "server/src",
    "spec",
    "README.md"
  ],
  "scripts": {
    "test": "jest server/tests --forceExit",
    "start": "node server/src/index.js",
    "demo": "node demo/demo.js",
    "bench": "node benchmarks/comparative.js"
  },
  "keywords": [
    "http",
    "sync",
    "synchronization",
    "delta",
    "json-patch",
    "merge-patch",
    "offline",
    "catch-up",
    "rest",
    "http-method"
  ],
  "author": "Meet Chauhan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meet-1010/sync-http-method.git"
  },
  "homepage": "https://github.com/Meet-1010/sync-http-method#readme",
  "bugs": {
    "url": "https://github.com/Meet-1010/sync-http-method/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "dependencies": {
    "fast-json-patch": "^3.1.1"
  },
  "devDependencies": {
    "braid-http": "^1.5.1",
    "express": "^5.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
